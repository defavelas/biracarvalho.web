<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block WordPress and malicious requests
    RewriteCond %{REQUEST_URI} (wp-|wp\.|wordpress|wp-content|wp-includes|wp-admin|xmlrpc\.php) [NC]
    RewriteRule ^ - [F,L]

    # Block common exploit attempts
    RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} proc/self/environ [OR]
    RewriteCond %{QUERY_STRING} mosConfig_[a-zA-Z_]{1,21}(=|\%3D) [OR]
    RewriteCond %{QUERY_STRING} base64_(en|de)code\(.*\) [OR]
    RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (\|%7C) [OR]
    RewriteCond %{QUERY_STRING} union.*select.*\( [NC,OR]
    RewriteCond %{QUERY_STRING} concat.*\( [NC]
    RewriteRule .* - [F,L]

    # Redirect to public/ directory for both domains
    RewriteCond %{HTTP_HOST} ^biracarvalho\.(bsonlabs\.com|observatoriodefavelas\.org\.br)$ [NC]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L,NC]

    # Allow traffic from both bsonlabs.com and observatoriodefavelas.org.br domains
    RewriteCond %{HTTP_HOST} ^(.*\.)?(bsonlabs\.com|observatoriodefavelas\.org\.br)$ [NC]
    RewriteRule ^ - [L]

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Canonical domain redirect (www to non-www)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# Enhanced Security Headers for GEO and SEO
<IfModule mod_headers.c>
    # Basic Security Headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Enhanced CSP for better security and AI crawler compatibility
    Header set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' https: data: blob:; font-src 'self' https: data:; connect-src 'self' https:; media-src 'self' https: data:; object-src 'none'; frame-ancestors 'self';"
    
    # Permissions Policy for modern browsers
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
    
    # AI Crawler and GEO optimization headers
    Header set X-Robots-Tag "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    Header set X-UA-Compatible "IE=edge"
    
    # Performance and caching headers
    Header set Vary "Accept-Encoding, User-Agent"
    
    # Accessibility and internationalization headers
    Header set Content-Language "pt-BR"
    Header set X-Content-Language "pt-BR"
</IfModule>

# Performance Optimization with GEO considerations
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Default expiration
    ExpiresDefault "access plus 1 month"
    
    # HTML files (for AI crawlers to get fresh content)
    ExpiresByType text/html "access plus 1 hour"
    
    # CSS, JS, Images (longer cache for performance)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    
    # Fonts
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # Documents and data files (for AI processing)
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType text/xml "access plus 1 day"
    ExpiresByType application/rss+xml "access plus 1 day"
    ExpiresByType application/atom+xml "access plus 1 day"
    
    # Sitemap files (frequent updates for crawlers)
    ExpiresByType application/xml "access plus 1 hour"
    <FilesMatch "sitemap.*\.xml$">
        ExpiresDefault "access plus 1 hour"
    </FilesMatch>
</IfModule>

# Enhanced Compression for better performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/ld+json
    AddOutputFilterByType DEFLATE application/x-httpd-php
    AddOutputFilterByType DEFLATE application/x-httpd-fastphp
    AddOutputFilterByType DEFLATE application/x-httpd-eruby
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# Cache Control with GEO optimization
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|webp|avif|woff|woff2|ttf|eot|otf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
</FilesMatch>

<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=3600, public, must-revalidate"
</FilesMatch>

<FilesMatch "\.(json|xml|rss|atom)$">
    Header set Cache-Control "max-age=86400, public, must-revalidate"
</FilesMatch>

# Sitemap specific caching for crawlers
<FilesMatch "sitemap.*\.xml$">
    Header set Cache-Control "max-age=3600, public, must-revalidate"
    Header set X-Robots-Tag "noindex, follow"
</FilesMatch>

# Block access to sensitive files
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op])|~)$">
    Order allow,deny
    Deny from all
    Satisfy All
</FilesMatch>

# Protect Laravel specific files
<FilesMatch "^(artisan|composer\.(json|lock)|package\.(json|lock)|\.env.*|phpunit\.xml)$">
    Order allow,deny
    Deny from all
    Satisfy All
</FilesMatch>

# Enable MIME type for modern formats
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType application/json .json
    AddType application/ld+json .jsonld
</IfModule>

# Character encoding for international content
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml .json .rss .atom